    <mxCell id="dc_2_clf" parent="1" vertex="1" value="&lt;b&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;Linear&lt;/font&gt;&lt;/b&gt;&lt;font style=&quot;font-size:9px;color:#CB4335;&quot;&gt;(64 → &lt;/font&gt;&lt;b&gt;&lt;font style=&quot;font-size:10px;color:#CB4335;&quot;&gt;5&lt;/font&gt;&lt;/b&gt;&lt;font style=&quot;font-size:9px;color:#CB4335;&quot;&gt;)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#7F8C8D;&quot;&gt;→ Logits ∈ ℝ&lt;sup&gt;5&lt;/sup&gt;&lt;/font&gt;" style="shape=rect;fillColor=#FADBD8;strokeColor=#CB4335;strokeWidth=1.5;rounded=1;align=center;verticalAlign=middle;fontSize=10;spacingTop=3;">
