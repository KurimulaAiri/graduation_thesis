    <mxCell id="agg" parent="1" vertex="1" value="&lt;b&gt;&lt;font style=&quot;font-size:14px;color:#7D6608;&quot;&gt;🔗 软投票平均 (Soft Voting)&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#5D4E37;&quot;&gt;torch.stack([out₀, out₁, out₂]).mean(dim=0)  →  Final Logits ∈ ℝ&lt;sup&gt;B×5&lt;/sup&gt;&lt;/font&gt;" style="shape=rect;fillColor=#F9E79F;strokeColor=#B7950B;strokeWidth=2;rounded=1;align=center;verticalAlign=middle;fontSize=13;spacingTop=8;shadow=1;">
