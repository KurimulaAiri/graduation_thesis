        <mxCell id="title" value="&lt;b&gt;&lt;font style=&quot;font-size: 20px&quot;&gt;多图神经网络抑郁症分类集成系统 (Ensemble System)&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Graph Neural Network Ensemble · 软投票融合机制 · 基于 PHQ-8 量表评测" style="text;html=1;strokeColor=#1E293B;fillColor=#0F172A;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontColor=#FFFFFF;arcSize=12;" parent="1" vertex="1">
