        <mxCell id="sage_c2" value="&lt;b&gt;SAGEConv (第二层采样聚合卷积)&lt;/b&gt;&lt;br&gt;公式: h_N(v) = mean({h_u, ∀u ∈ N(v)})" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5EEF8;strokeColor=#6C3483;" parent="1" vertex="1">
