        <mxCell id="voting" value="&lt;b&gt;软投票决策融合器 (Soft Voting Mechanism)&lt;/b&gt;&lt;br&gt;Final_Logits = mean(torch.stack([Logits_gcn, Logits_gat, Logits_sage]), dim=0) → Final Logits ∈ ℝᴮˣ⁵" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF9E7;strokeColor=#D4AC0D;strokeWidth=2;fontColor=#7D6608;" parent="1" vertex="1">
